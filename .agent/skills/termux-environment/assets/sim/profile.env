# termux-sim default profile: a non-root Termux install on aarch64.
# Format: key=value, one per line, no inline comments. Key names match the
# output of scripts/device-facts.sh, so a device-facts output file passed with
# --profile replaces these values with facts from a real device.
#
# Provenance of the defaults:
#   termux.version  tag of the latest termux-app release when this file was written
#   pkg.*           versions in termux-packages master when this file was written;
#                   a device can lag behind its mirror
#   everything else placeholders chosen by this tool, not facts about any device
termux.version=0.118.3
android.release=14
android.sdk=34
arch.uname=aarch64
arch.packages=aarch64
kernel.release=5.10.0-termux-sim
kernel.version=#1 SMP PREEMPT termux-sim
device.manufacturer=Sim
device.model=Termux-Sim
user.name=u0_a160
user.uid=10160
user.gid=10160
root.available=no
pkg.dash=0.5.13.5
pkg.bash=5.3.20
pkg.coreutils=9.12
pkg.termux-exec=1:2.5.0
pkg.termux-tools=1.46.0+really1.45.0-1
pkg.termux-core=0.4.0
pkg.zsh=not-installed
pkg.termux-api=not-installed
