root = true

[*.{sh,bash,zsh}]
indent_style = space
indent_size = 2
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[boot/*]
indent_style = space
indent_size = 2
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
switch_case_indent = true
binary_next_line = true
space_redirects = true

[*.{sh,bash}]
switch_case_indent = true
binary_next_line = true
space_redirects = true
